# Copy this file to .env and fill in the real values. Never commit .env.

# Supabase connection string.
#   Dashboard -> Project Settings -> Database -> Connection string -> URI
# Prefer the Session pooler (port 6543). URL-encode any special characters
# in the password (@ and : must be percent-encoded).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Optional: where the built frontend (vite build output) lives.
# Defaults to <backend>/../dist. Set this only if frontend and backend are
# deployed to different machines.
# FRONTEND_DIST=/var/www/cashtrack/dist
